[Unit]
Description=Verified SQLite backup for Snake Club
After=gamebot.service

[Service]
Type=oneshot
User=gamebot
Group=gamebot
Environment=DB_PATH=/var/lib/gamebot/snake.sqlite
Environment=BACKUP_DIR=/var/lib/gamebot/backups
ExecStart=/opt/node24/bin/node /opt/gamebot/scripts/backup.js
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gamebot
RestrictAddressFamilies=AF_UNIX
